generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMINISTRATOR
  RECRUITER
  HIRING_MANAGER
  INTERVIEWER
  VIEWER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum JobStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
}

enum WorkplaceType {
  ON_SITE
  HYBRID
  REMOTE
}

enum CandidateStatus {
  APPLIED
  REVIEWING
  INTERVIEW_SCHEDULED
  INTERVIEW_PASSED
  REJECTED
  HIRED
}

enum InterviewType {
  HR
  TECHNICAL
  TEAM_LEAD
  MANAGER
  FINAL
  CUSTOM
}

enum InterviewStatus {
  DRAFT
  SCHEDULED
  WAITING_CANDIDATE_CONFIRMATION
  ACCEPTED
  RESCHEDULE_REQUESTED
  DECLINED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InterviewCandidateResponse {
  ACCEPTED
  RESCHEDULE_REQUESTED
  DECLINED
}

enum InterviewStatusActor {
  RECRUITER
  CANDIDATE
  SYSTEM
}

enum InterviewProcessStatus {
  WAITING
  INTERVIEWING
  PASSED
  FAILED
  HIRED
}

enum InterviewResult {
  PASSED
  FAILED
  PENDING
}

enum ApplicationActivityType {
  APPLICATION_SUBMITTED
  RESUME_PROCESSED
  AI_ANALYSIS_COMPLETED
  STATUS_CHANGED
  NOTE_ADDED
  NOTE_UPDATED
  NOTE_DELETED
  INTERVIEW_SCHEDULED
  INTERVIEW_UPDATED
  INTERVIEW_CANCELLED
  INTERVIEW_COMPLETED
  INTERVIEW_STARTED
  INTERVIEW_NO_SHOW
  INTERVIEW_PROCESS_UPDATED
  INTERVIEW_ACCEPTED
  INTERVIEW_RESCHEDULE_REQUESTED
  INTERVIEW_DECLINED
  INTERVIEW_RESCHEDULED
}

enum NotificationCategory {
  CANDIDATES
  JOBS
  INTERVIEWS
  ORGANIZATION
  SYSTEM
  AI
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

enum AiCreditFeature {
  GENERATE_JOB
  RESUME_ANALYSIS
  RESUME_AUTOFILL
  CANDIDATE_RANKING
  INTERVIEW_QUESTIONS
  INTERVIEW_SUMMARY
}

enum AiCreditTransactionType {
  GRANT
  CONSUME
  REFUND
  ADJUSTMENT
  BONUS
  PURCHASE
  EXPIRATION
}

enum PlatformRole {
  NONE
  PLATFORM_ADMIN
}

enum SupportTicketCategory {
  GENERAL
  BUG_REPORT
  FEATURE_REQUEST
  BILLING
  AI
  OTHER
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum SupportTicketStatus {
  OPEN
  WAITING_FOR_ADMIN
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportMessageAuthorType {
  CUSTOMER
  PLATFORM_ADMIN
  SYSTEM
}

enum SupportAuditAction {
  TICKET_CREATED
  TICKET_REPLIED
  STATUS_CHANGED
  RESOLVED
  CLOSED
  REOPENED
  ASSIGNED
}

model Organization {
  id                      String      @id @default(uuid()) @db.Uuid
  name                    String      @db.VarChar(80)
  slug                    String      @unique @db.VarChar(120)
  displayName             String?     @map("display_name") @db.VarChar(80)
  description             String?     @db.VarChar(300)
  email                   String      @db.VarChar(255)
  phone                   String?     @db.VarChar(20)
  website                 String?     @db.VarChar(255)
  country                 String?     @db.VarChar(80)
  city                    String?     @db.VarChar(80)
  address                 String?     @db.VarChar(300)
  timezone                String      @default("Asia/Tehran") @db.VarChar(64)
  language                String      @default("fa") @db.VarChar(8)
  primaryColor            String      @default("#150578") @map("primary_color") @db.VarChar(7)
  secondaryColor          String      @default("#3943B7") @map("secondary_color") @db.VarChar(7)
  logoId                  String?     @map("logo_id") @db.Uuid
  darkLogoId              String?     @map("dark_logo_id") @db.Uuid
  logo                    StoredFile? @relation("OrganizationLogo", fields: [logoId], references: [id], onDelete: SetNull)
  darkLogo                StoredFile? @relation("OrganizationDarkLogo", fields: [darkLogoId], references: [id], onDelete: SetNull)
  newCandidateEmail       Boolean     @default(true) @map("new_candidate_email")
  candidateStatusEmail    Boolean     @default(false) @map("candidate_status_email")
  interviewReminderEmail  Boolean     @default(true) @map("interview_reminder_email")
  jobExpirationEmail      Boolean     @default(true) @map("job_expiration_email")
  jobPublishedEmail       Boolean     @default(false) @map("job_published_email")
  defaultCurrency         String      @default("IRR") @map("default_currency") @db.VarChar(3)
  createdAt               DateTime    @default(now()) @map("created_at")
  updatedAt               DateTime    @updatedAt @map("updated_at")
  users                   User[]
  departments             Department[]
  jobs                    Job[]
  candidates              Candidate[]
  applications            Application[]
  skills                  Skill[]
  jobTemplates            JobTemplate[]
  files                   StoredFile[] @relation("OrganizationFiles")
  candidateNotes          CandidateNote[]
  interviewProcesses      InterviewProcess[]
  interviews              Interview[]
  applicationActivities   ApplicationActivityEvent[]
  notifications           Notification[]
  notificationDeliveries  NotificationDelivery[]
  aiCredits               OrganizationAiCredits?
  aiCreditTransactions    AiCreditTransaction[]
  supportTickets          SupportTicket[]
  betaFeedbackResponses   BetaFeedbackResponse[]

  @@unique([email])
  @@map("organizations")
}

model Department {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String        @db.VarChar(100)
  description    String?       @db.VarChar(1000)
  color          String?       @db.VarChar(7)
  managerId      String?       @map("manager_id") @db.Uuid
  manager        User?         @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  isDefault      Boolean       @default(false) @map("is_default")
  archivedAt     DateTime?     @map("archived_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  members        User[]        @relation("UserDepartment")
  jobs           Job[]
  jobTemplates   JobTemplate[]

  @@unique([organizationId, name])
  @@index([organizationId, archivedAt])
  @@map("departments")
}

model StoredFile {
  id               String         @id @default(uuid()) @db.Uuid
  organizationId   String         @map("organization_id") @db.Uuid
  organization     Organization   @relation("OrganizationFiles", fields: [organizationId], references: [id], onDelete: Cascade)
  provider         String         @db.VarChar(50)
  bucket           String         @db.VarChar(255)
  objectKey        String         @map("object_key") @db.VarChar(512)
  originalName     String         @map("original_name") @db.VarChar(255)
  mimeType         String         @map("mime_type") @db.VarChar(100)
  extension        String         @db.VarChar(20)
  sizeBytes        Int            @map("size_bytes")
  etag             String?        @db.VarChar(255)
  publicUrl        String?        @map("public_url") @db.Text
  createdAt        DateTime       @default(now()) @map("created_at")
  logoFor          Organization[] @relation("OrganizationLogo")
  darkLogoFor      Organization[] @relation("OrganizationDarkLogo")
  resumeApplications Application[] @relation("ApplicationResume")
  supportAttachments SupportAttachment[]

  @@index([organizationId])
  @@index([objectKey])
  @@map("stored_files")
}

model User {
  id                 String                   @id @default(uuid()) @db.Uuid
  email              String                   @unique @db.VarChar(255)
  passwordHash       String                   @map("password_hash")
  role               UserRole                 @default(OWNER)
  platformRole       PlatformRole             @default(NONE) @map("platform_role")
  status             UserStatus               @default(ACTIVE)
  isEmailVerified    Boolean                  @default(false) @map("is_email_verified")
  lastLoginAt        DateTime?                @map("last_login_at")
  organizationId     String                   @map("organization_id") @db.Uuid
  organization       Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId       String                   @map("department_id") @db.Uuid
  department         Department               @relation("UserDepartment", fields: [departmentId], references: [id], onDelete: Restrict)
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")
  verificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  sessions           Session[]
  candidateNotes     CandidateNote[]
  interviewsCreated  Interview[]               @relation("InterviewCreatedBy")
  interviewsAssigned Interview[]               @relation("InterviewRecruiter")
  activityEvents     ApplicationActivityEvent[]
  managedDepartments      Department[]             @relation("DepartmentManager")
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  notificationDeliveries  NotificationDelivery[]
  aiCreditTransactions    AiCreditTransaction[]
  supportTicketsCreated   SupportTicket[]          @relation("SupportTicketCreatedBy")
  supportTicketsAssigned  SupportTicket[]          @relation("SupportTicketAssignedTo")
  supportMessages         SupportMessage[]
  supportAuditEvents      SupportAuditEvent[]
  betaFeedbackResponses   BetaFeedbackResponse[]

  @@index([organizationId, departmentId])
  @@index([platformRole])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(512)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

model Job {
  id               String          @id @default(uuid()) @db.Uuid
  title            String          @db.VarChar(100)
  department       String?         @db.VarChar(80)
  departmentId     String          @map("department_id") @db.Uuid
  departmentRef    Department      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  employmentType   EmploymentType  @map("employment_type")
  workplaceType    WorkplaceType   @map("workplace_type")
  location         String?         @db.VarChar(120)
  salaryMin        Int?            @map("salary_min")
  salaryMax        Int?            @map("salary_max")
  currency         String          @default("IRR") @db.VarChar(3)
  salaryVisible    Boolean         @default(true) @map("salary_visible")
  description      String          @db.Text
  responsibilities String?         @db.Text
  requirements     String?         @db.Text
  benefits         String?         @db.Text
  positions        Int             @default(1)
  expirationDate            DateTime?       @map("expiration_date") @db.Date
  expirationReminderSentAt  DateTime?       @map("expiration_reminder_sent_at")
  status                    JobStatus       @default(DRAFT)
  publishedAt               DateTime?       @map("published_at")
  organizationId            String          @map("organization_id") @db.Uuid
  organization              Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidates                Candidate[]
  applications              Application[]
  interviewProcesses        InterviewProcess[]
  interviews                Interview[]
  skills                    JobSkill[]
  createdAt                 DateTime        @default(now()) @map("created_at")
  updatedAt                 DateTime        @updatedAt @map("updated_at")

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([organizationId, departmentId])
  @@index([status, expirationDate])
  @@map("jobs")
}

model Skill {
  id             String       @id @default(uuid()) @db.Uuid
  name           String       @db.VarChar(80)
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobs           JobSkill[]
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("skills")
}

model JobSkill {
  jobId     String   @map("job_id") @db.Uuid
  skillId   String   @map("skill_id") @db.Uuid
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([jobId, skillId])
  @@index([skillId])
  @@map("job_skills")
}

model JobTemplate {
  id               String          @id @default(uuid()) @db.Uuid
  name             String          @db.VarChar(120)
  title            String          @db.VarChar(100)
  department       String?         @db.VarChar(80)
  departmentId     String?         @map("department_id") @db.Uuid
  departmentRef    Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employmentType   EmploymentType  @map("employment_type")
  workplaceType    WorkplaceType   @map("workplace_type")
  location         String?         @db.VarChar(120)
  salaryMin        Int?            @map("salary_min")
  salaryMax        Int?            @map("salary_max")
  currency         String          @default("IRR") @db.VarChar(3)
  salaryVisible    Boolean         @default(true) @map("salary_visible")
  description      String          @db.Text
  responsibilities String?         @db.Text
  requirements     String?         @db.Text
  benefits         String?         @db.Text
  skills           String[]        @default([])
  positions        Int             @default(1)
  organizationId   String          @map("organization_id") @db.Uuid
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@index([organizationId, createdAt])
  @@map("job_templates")
}

model Candidate {
  id              String          @id @default(uuid()) @db.Uuid
  fullName        String          @map("full_name") @db.VarChar(120)
  email           String          @db.VarChar(255)
  phone           String          @db.VarChar(40)
  currentPosition String?         @map("current_position") @db.VarChar(120)
  skills          Json?
  experience      String?         @db.Text
  education       String?         @db.Text
  linkedin        String?         @db.VarChar(255)
  portfolio       String?         @db.VarChar(255)
  website         String?         @db.VarChar(255)
  status          CandidateStatus @default(APPLIED)
  aiScore         Int?            @map("ai_score")
  jobId           String?         @map("job_id") @db.Uuid
  job             Job?            @relation(fields: [jobId], references: [id], onDelete: SetNull)
  organizationId  String          @map("organization_id") @db.Uuid
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applications       Application[]
  interviewProcesses InterviewProcess[]
  interviews         Interview[]
  appliedAt          DateTime        @default(now()) @map("applied_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  @@unique([organizationId, email])
  @@index([organizationId, appliedAt])
  @@index([jobId])
  @@map("candidates")
}

model Application {
  id                String                     @id @default(uuid()) @db.Uuid
  status            CandidateStatus            @default(APPLIED)
  trackingTokenHash String                     @unique @map("tracking_token_hash") @db.VarChar(64)
  extractedText     String?                    @map("extracted_text") @db.Text
  aiAnalysis        Json?                      @map("ai_analysis")
  jobMatchAnalysis  Json?                      @map("job_match_analysis")
  yearsExperience   Int?                       @map("years_experience")
  resumeFileId      String?                    @map("resume_file_id") @db.Uuid
  resumeFile        StoredFile?                @relation("ApplicationResume", fields: [resumeFileId], references: [id], onDelete: SetNull)
  candidateId       String                     @map("candidate_id") @db.Uuid
  candidate         Candidate                  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId             String                     @map("job_id") @db.Uuid
  job               Job                        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  organizationId    String                     @map("organization_id") @db.Uuid
  organization      Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  statusEvents      ApplicationStatusEvent[]
  activityEvents    ApplicationActivityEvent[]
  notes             CandidateNote[]
  interviewProcess  InterviewProcess?
  interviews        Interview[]
  notifications     Notification[]
  appliedAt         DateTime                   @default(now()) @map("applied_at")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")

  @@unique([jobId, candidateId])
  @@index([organizationId, appliedAt])
  @@index([jobId])
  @@index([candidateId])
  @@map("applications")
}

model Notification {
  id             String               @id @default(uuid()) @db.Uuid
  eventId        String               @map("event_id") @db.VarChar(64)
  eventName      String               @map("event_name") @db.VarChar(80)
  organizationId String?              @map("organization_id") @db.Uuid
  organization   Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?              @map("user_id") @db.Uuid
  user           User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId  String?              @map("application_id") @db.Uuid
  application    Application?         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  recipientKey   String               @map("recipient_key") @db.VarChar(80)
  category       NotificationCategory
  title          String               @db.VarChar(200)
  description    String               @db.VarChar(500)
  actionUrl      String?              @map("action_url") @db.VarChar(500)
  priority       NotificationPriority @default(NORMAL)
  isRead         Boolean              @default(false) @map("is_read")
  readAt         DateTime?            @map("read_at")
  isMandatory    Boolean              @default(false) @map("is_mandatory")
  metadata       Json?
  createdAt      DateTime             @default(now()) @map("created_at")
  archivedAt     DateTime?            @map("archived_at")
  deliveries     NotificationDelivery[]

  @@unique([eventId, recipientKey])
  @@index([userId, createdAt])
  @@index([userId, isRead, createdAt])
  @@index([applicationId, createdAt])
  @@index([organizationId, createdAt])
  @@index([archivedAt])
  @@map("notifications")
}

model NotificationPreference {
  id           String               @id @default(uuid()) @db.Uuid
  userId       String               @map("user_id") @db.Uuid
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     NotificationCategory
  inAppEnabled Boolean              @default(true) @map("in_app_enabled")
  emailEnabled Boolean              @default(true) @map("email_enabled")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  @@unique([userId, category])
  @@index([userId])
  @@map("notification_preferences")
}

model NotificationDelivery {
  id             String                     @id @default(uuid()) @db.Uuid
  notificationId String                     @map("notification_id") @db.Uuid
  notification   Notification               @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  organizationId String?                    @map("organization_id") @db.Uuid
  organization   Organization?              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?                    @map("user_id") @db.Uuid
  user           User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  channel        NotificationChannel
  status         NotificationDeliveryStatus @default(PENDING)
  attemptNumber  Int                        @default(1) @map("attempt_number")
  errorMessage   String?                    @map("error_message") @db.VarChar(500)
  createdAt      DateTime                   @default(now()) @map("created_at")

  @@index([notificationId, createdAt])
  @@index([status, createdAt])
  @@map("notification_deliveries")
}

model ApplicationStatusEvent {
  id            String          @id @default(uuid()) @db.Uuid
  applicationId String          @map("application_id") @db.Uuid
  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status        CandidateStatus
  createdAt     DateTime        @default(now()) @map("created_at")

  @@index([applicationId, createdAt])
  @@map("application_status_events")
}

model ApplicationActivityEvent {
  id             String                  @id @default(uuid()) @db.Uuid
  applicationId  String                  @map("application_id") @db.Uuid
  application    Application             @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  organizationId String                  @map("organization_id") @db.Uuid
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           ApplicationActivityType
  description    String                  @db.VarChar(500)
  actorUserId    String?                 @map("actor_user_id") @db.Uuid
  actorUser      User?                   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  metadata       Json?
  createdAt      DateTime                @default(now()) @map("created_at")

  @@index([applicationId, createdAt])
  @@index([organizationId, createdAt])
  @@map("application_activity_events")
}

model CandidateNote {
  id             String       @id @default(uuid()) @db.Uuid
  applicationId  String       @map("application_id") @db.Uuid
  application    Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  authorUserId   String       @map("author_user_id") @db.Uuid
  authorUser     User         @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  body           String       @db.VarChar(5000)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([applicationId, createdAt])
  @@index([organizationId])
  @@map("candidate_notes")
}

model InterviewProcess {
  id             String                 @id @default(uuid()) @db.Uuid
  applicationId  String                 @unique @map("application_id") @db.Uuid
  application    Application            @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  organizationId String                 @map("organization_id") @db.Uuid
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobId          String                 @map("job_id") @db.Uuid
  job            Job                    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId    String                 @map("candidate_id") @db.Uuid
  candidate      Candidate              @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  status               InterviewProcessStatus @default(WAITING)
  aiSummary            Json?                  @map("ai_summary")
  aiSummaryGeneratedAt DateTime?              @map("ai_summary_generated_at")
  stages               Interview[]
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  @@index([organizationId, status])
  @@index([jobId])
  @@index([candidateId])
  @@map("interview_processes")
}

model Interview {
  id               String           @id @default(uuid()) @db.Uuid
  processId        String           @map("process_id") @db.Uuid
  process          InterviewProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  applicationId    String           @map("application_id") @db.Uuid
  application      Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  organizationId   String           @map("organization_id") @db.Uuid
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobId            String           @map("job_id") @db.Uuid
  job              Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId      String           @map("candidate_id") @db.Uuid
  candidate        Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  name             String           @db.VarChar(120)
  scheduledAt      DateTime         @map("scheduled_at")
  type             InterviewType
  status           InterviewStatus  @default(WAITING_CANDIDATE_CONFIRMATION)
  result           InterviewResult?
  location         String?          @db.VarChar(255)
  meetingUrl       String?          @map("meeting_url") @db.VarChar(500)
  internalNotes    String?          @map("internal_notes") @db.VarChar(5000)
  candidateNotes   String?          @map("candidate_notes") @db.VarChar(5000)
  candidateResponse InterviewCandidateResponse? @map("candidate_response")
  respondedAt      DateTime?        @map("responded_at")
  responseMessage  String?          @map("response_message") @db.VarChar(2000)
  proposedScheduledAt DateTime?     @map("proposed_scheduled_at")
  aiPreparation    Json?            @map("ai_preparation")
  aiPrompt         String?          @map("ai_prompt") @db.VarChar(2000)
  aiGeneratedAt    DateTime?        @map("ai_generated_at")
  recruiterUserId  String?          @map("recruiter_user_id") @db.Uuid
  recruiterUser    User?            @relation("InterviewRecruiter", fields: [recruiterUserId], references: [id], onDelete: SetNull)
  createdByUserId  String           @map("created_by_user_id") @db.Uuid
  createdByUser    User             @relation("InterviewCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  statusEvents     InterviewStatusEvent[]
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@index([processId, scheduledAt])
  @@index([applicationId, scheduledAt])
  @@index([organizationId, scheduledAt])
  @@index([jobId])
  @@index([candidateId])
  @@index([recruiterUserId, scheduledAt])
  @@index([status])
  @@map("interviews")
}

model InterviewStatusEvent {
  id           String               @id @default(uuid()) @db.Uuid
  interviewId  String               @map("interview_id") @db.Uuid
  interview    Interview            @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  fromStatus   InterviewStatus?     @map("from_status")
  toStatus     InterviewStatus      @map("to_status")
  actorType    InterviewStatusActor @map("actor_type")
  actorUserId  String?              @map("actor_user_id") @db.Uuid
  message      String?              @db.VarChar(2000)
  metadata     Json?
  createdAt    DateTime             @default(now()) @map("created_at")

  @@index([interviewId, createdAt])
  @@map("interview_status_events")
}

model OrganizationAiCredits {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @unique @map("organization_id") @db.Uuid
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  balance          Int          @default(0)
  lifetimeGranted  Int          @default(0) @map("lifetime_granted")
  lifetimeConsumed Int          @default(0) @map("lifetime_consumed")
  /// Reserved for future monthly subscription renewals.
  renewsAt         DateTime?    @map("renews_at")
  /// Reserved for future credit expiration.
  expiresAt        DateTime?    @map("expires_at")
  /// Reserved for future plan codes (e.g. beta, pro, unlimited).
  planCode         String?      @map("plan_code") @db.VarChar(64)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  @@map("organization_ai_credits")
}

model AiCreditTransaction {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?                 @map("user_id") @db.Uuid
  user           User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  type           AiCreditTransactionType
  feature        AiCreditFeature?
  /// Always positive; direction is determined by `type`.
  amount         Int
  balanceAfter   Int                     @map("balance_after")
  metadata       Json?
  createdAt      DateTime                @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@index([organizationId, feature, type])
  @@index([userId])
  @@map("ai_credit_transactions")
}

model SupportTicket {
  id               String                 @id @default(uuid()) @db.Uuid
  organizationId   String                 @map("organization_id") @db.Uuid
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUserId  String                 @map("created_by_user_id") @db.Uuid
  createdByUser    User                   @relation("SupportTicketCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  assignedToUserId String?                @map("assigned_to_user_id") @db.Uuid
  assignedToUser   User?                  @relation("SupportTicketAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  subject          String                 @db.VarChar(200)
  category         SupportTicketCategory
  priority         SupportTicketPriority  @default(MEDIUM)
  status           SupportTicketStatus    @default(OPEN)
  firstResponseAt  DateTime?              @map("first_response_at")
  resolvedAt       DateTime?              @map("resolved_at")
  closedAt         DateTime?              @map("closed_at")
  lastMessageAt    DateTime               @default(now()) @map("last_message_at")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  messages         SupportMessage[]
  attachments      SupportAttachment[]
  auditEvents      SupportAuditEvent[]

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([status, priority, createdAt])
  @@index([assignedToUserId])
  @@index([lastMessageAt])
  @@map("support_tickets")
}

model SupportMessage {
  id          String                   @id @default(uuid()) @db.Uuid
  ticketId    String                   @map("ticket_id") @db.Uuid
  ticket      SupportTicket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorUserId String?                 @map("author_user_id") @db.Uuid
  authorUser  User?                    @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  authorType  SupportMessageAuthorType @map("author_type")
  content     String                   @db.Text
  /// Reserved for future internal admin-only notes.
  isInternal  Boolean                  @default(false) @map("is_internal")
  createdAt   DateTime                 @default(now()) @map("created_at")
  attachments SupportAttachment[]

  @@index([ticketId, createdAt])
  @@index([authorUserId])
  @@map("support_messages")
}

model SupportAttachment {
  id             String         @id @default(uuid()) @db.Uuid
  ticketId       String         @map("ticket_id") @db.Uuid
  ticket         SupportTicket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  messageId      String?        @map("message_id") @db.Uuid
  message        SupportMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileId         String         @map("file_id") @db.Uuid
  file           StoredFile     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  organizationId String         @map("organization_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at")

  @@index([ticketId])
  @@index([messageId])
  @@index([fileId])
  @@map("support_attachments")
}

model SupportAuditEvent {
  id          String             @id @default(uuid()) @db.Uuid
  ticketId    String             @map("ticket_id") @db.Uuid
  ticket      SupportTicket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorUserId String?            @map("actor_user_id") @db.Uuid
  actorUser   User?              @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      SupportAuditAction
  fromStatus  SupportTicketStatus? @map("from_status")
  toStatus    SupportTicketStatus? @map("to_status")
  metadata    Json?
  createdAt   DateTime           @default(now()) @map("created_at")

  @@index([ticketId, createdAt])
  @@index([actorUserId])
  @@map("support_audit_events")
}

/// Flexible product-validation survey responses (versioned via surveyKey + surveyVersion).
model BetaFeedbackResponse {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submittedByUserId String       @map("submitted_by_user_id") @db.Uuid
  submittedByUser   User         @relation(fields: [submittedByUserId], references: [id], onDelete: Cascade)
  surveyKey         String       @map("survey_key") @db.VarChar(64)
  surveyVersion     String       @map("survey_version") @db.VarChar(32)
  productVersion    String?      @map("product_version") @db.VarChar(64)
  answers           Json
  submittedAt       DateTime     @default(now()) @map("submitted_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  @@unique([organizationId, surveyKey])
  @@index([surveyKey, surveyVersion, submittedAt])
  @@index([submittedAt])
  @@map("beta_feedback_responses")
}
